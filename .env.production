NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# --- Dashboard login credentials ---
ADMIN_EMAIL=admin@webnox.io
ADMIN_PASSWORD=ChangeMe@123
AUTH_SECRET=change-this-to-a-long-random-string-9f8e7d6c5b4a

# --- Production Databases ---
# GST CRM (hosts BOTH GST companies as separate tenants)
# Use 192.168.0.26 or localhost depending on whether common_dashboard is deployed on the same server
GST_DATABASE_URL=postgresql://crm_user:CHANGE_TO_YOUR_PASSWORD@192.168.0.26:5475/crmdb

# Non-GST CRM
NONGST_DATABASE_URL=postgresql://crmnewuser:Test12345@192.168.0.26:5478/crmnewdb

# Tenant IDs inside each database
GST_TENANT_WEBNOX_ID=6e66fd13-2abb-4407-ab35-9412a1589985
GST_TENANT_PVT_ID=3fda6cd8-d044-4461-ab09-3c9649b124b5
NONGST_TENANT_ID=default-tenant-id

# Unassigned lead pool lives in its dedicated Docker PostgreSQL container (port 5480)
HUB_DATABASE_URL=postgresql://hub_user:HubPassword123!@192.168.0.26:5480/hubdb

# Key for the public website-form endpoint: POST /api/leads/intake (header: x-api-key)
INTAKE_API_KEY=change-this-intake-key

